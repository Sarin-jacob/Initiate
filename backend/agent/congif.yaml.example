server:
  url: "ws://127.0.0.1:8080/api/ws/agent"
  cert_pin: ""
  private_key_path: "agent.key"

modules:

  # ---------------------------------------------------------
  # Module: system_user
  # Manages the base OS-level Linux user lifecycle
  # ---------------------------------------------------------

  system_user:
    create:
      description: "Creates a new Linux user with a home directory and bash shell."
      variables:
        username: string
      command: "/usr/sbin/useradd"
      args: ["-m", "-s", "/bin/bash", "{{.username}}"]

    delete:
      description: "Terminates all user processes and deletes the Linux user with their home directory."
      variables:
        username: string
      command: "/bin/bash"
      args:
        - "-c"
        - "pkill -9 -u {{.username}} || true; sleep 1; /usr/sbin/userdel -r -f {{.username}}"

    suspend:
      description: "Locks the Linux user account."
      variables:
        username: string
      command: "/usr/sbin/usermod"
      args: ["-L", "{{.username}}"]

    resume:
      description: "Unlocks the Linux user account."
      variables:
        username: string
      command: "/usr/sbin/usermod"
      args: ["-U", "{{.username}}"]

    set_password:
      description: "Sets or updates the user's local OS password."
      variables:
        username: string
        password: secret
      command: "/usr/bin/bash"
      args:
        - "-c"
        - "echo '{{.username}}:{{.password}}' | /usr/sbin/chpasswd"

  # ---------------------------------------------------------
  # Module: ssh_key
  # Manages the secure shell access keys for the user
  # ---------------------------------------------------------

  ssh_key:
    create:
      description: "Creates the .ssh directory and injects the public key with strict permissions."
      variables:
        username: string
        ssh_public_key: textarea
      command: "/usr/bin/bash"
      args:
        - "-c"
        - |
          mkdir -p /home/{{.username}}/.ssh &&
          echo '{{.ssh_public_key}}' >> /home/{{.username}}/.ssh/authorized_keys &&
          chown -R {{.username}}:{{.username}} /home/{{.username}}/.ssh &&
          chmod 700 /home/{{.username}}/.ssh &&
          chmod 600 /home/{{.username}}/.ssh/authorized_keys

    delete:
      description: "Revokes SSH access by deleting the authorized_keys file."
      variables:
        username: string
      command: "/usr/bin/rm"
      args: ["-f", "/home/{{.username}}/.ssh/authorized_keys"]

  # ---------------------------------------------------------
  # Module: dev
  # ---------------------------------------------------------

  dev:
    init_uv:
      description: "Creates the uv project in users home directory."
      variables:
        username: string
      command: "/usr/bin/bash"
      args:
        - "-c"
        - "sudo -u {{.username}} sh -c 'cd /home/{{.username}} && uv init --bare'"

  # ---------------------------------------------------------
  # Module: system_group
  # ---------------------------------------------------------

  system_group:
    add_user:
      description: "Appends the user to a supplementary secondary group (e.g. docker, sudo)."
      variables:
        username: string
        group: string
      command: "/usr/sbin/usermod"
      args: ["-aG", "{{.group}}", "{{.username}}"]

    add_to_uv:
      description: "Appends the user to uv-cache group."
      variables:
        username: string
      command: "/usr/sbin/usermod"
      args: ["-aG", "uv-cache", "{{.username}}"]

    remove_user:
      description: "Removes a user from a specific supplementary group."
      variables:
        username: string
        group: string
      command: "/usr/bin/gpasswd"
      args: ["-d", "{{.username}}", "{{.group}}"]

    create:
      description: "Creates a new system group if it does not exist."
      variables:
        group: string
      command: "/usr/sbin/groupadd"
      args: ["-f", "{{.group}}"]

    delete:
      description: "Deletes an existing system group."
      variables:
        group: string
      command: "/usr/sbin/groupdel"
      args: ["{{.group}}"]


  jupyter:
    generate:
      description: "Installs JupyterLab, generates SSL certs, and configures secure 0.0.0.0 access."
      variables:
        username: string
        password: secret
      command: "/bin/bash"
      args:
        - "-c"
        - |
          su - {{.username}} -s /bin/bash << 'EOF'
          set -e
          
          echo "==> Installing JupyterLab and Git extension via uv..."
          uv add jupyterlab jupyterlab-git
          
          echo "==> Generating Jupyter Lab config..."
          uv run jupyter lab --generate-config -y >/dev/null 2>&1
          
          echo "==> Generating personal SSL Certificate for secure remote access..."
          mkdir -p ~/.jupyter
          openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
              -keyout ~/.jupyter/mykey.key \
              -out ~/.jupyter/mycert.pem \
              -subj "/C=IN/ST=Server/L=DataCenter/O=Nexus/CN=localhost" >/dev/null 2>&1
          
          echo "==> Updating configuration..."
          uv run python -c "
          import os
          import re
          from jupyter_server.auth import passwd
          
          raw_password = '''{{.password}}'''
          hashed_password = passwd(raw_password)
          
          config_path = os.path.expanduser('~/.jupyter/jupyter_lab_config.py')
          cert_path = os.path.expanduser('~/.jupyter/mycert.pem')
          key_path = os.path.expanduser('~/.jupyter/mykey.key')
          
          with open(config_path, 'r') as f:
              content = f.read()
          
          # Bind to 0.0.0.0 but FORCE encrypted HTTPS!
          settings = {
              'c.ServerApp.ip': \"'0.0.0.0'\",
              'c.ServerApp.allow_remote_access': 'True',
              'c.ServerApp.port': '0',
              'c.ServerApp.open_browser': 'False',
              'c.ServerApp.password': f\"'{hashed_password}'\",
              'c.ServerApp.certfile': f\"'{cert_path}'\",
              'c.ServerApp.keyfile': f\"'{key_path}'\"
          }
          
          for key, val in settings.items():
              pattern = r'^\s*#?\s*' + re.escape(key) + r'\s*=.*$'
              replacement = f'{key} = {val}'
              if re.search(pattern, content, re.MULTILINE):
                  content = re.sub(pattern, replacement, content, flags=re.MULTILINE)
              else:
                  content += f'\n{replacement}\n'
          
          with open(config_path, 'w') as f:
              f.write(content)
          "
          EOF